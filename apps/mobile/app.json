{
  "expo": {
    "name": "Flash-n-Flip",
    "slug": "flash-n-flip",
    "version": "0.5.27",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "flash-n-flip",
      "flora"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "eu.flora.flashcards"
    },
    "android": {
      "package": "eu.flora.flashcards",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5C505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5C505",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://127.0.0.1:4000",
      "eas": {
        "projectId": "TODO_EAS_PROJECT_ID"
      }
    }
  }
}
