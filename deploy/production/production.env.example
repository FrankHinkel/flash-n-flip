NODE_ENV=production

POSTGRES_DB=flashcards
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://flashcards:replace-with-the-same-password@postgres:5432/flashcards

API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=https://flash-n-flip.com/api
API_INTERNAL_URL=http://api:4000
ALLOWED_ORIGINS=https://flash-n-flip.com
NEXT_PUBLIC_API_URL=/api

JWT_SECRET=replace-with-at-least-32-random-characters
FNF_DECK_MASTER_SECRET=replace-with-an-independent-random-secret
FNF_ADMIN_ACCESS_PASSWORD_FILE=/run/secrets/admin-access-password

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_BYTES=5242880
APKG_MAX_UPLOAD_BYTES=268435456
FNF_MAX_PACKAGE_BYTES=262144000

PUBLIC_REGISTRATION_ENABLED=false
