{
  "name": "@flashcards/sync",
  "version": "0.5.116",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./rendezvous": {
      "types": "./src/rendezvous.ts",
      "react-native": "./src/rendezvous.ts",
      "default": "./dist/rendezvous.js"
    },
    "./local-authority": {
      "types": "./src/local-authority.ts",
      "react-native": "./src/local-authority.ts",
      "default": "./dist/local-authority.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flashcards/domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
