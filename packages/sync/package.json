{
  "name": "@flashcards/sync",
  "version": "0.5.155",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./rendezvous": {
      "types": "./src/rendezvous.ts",
      "react-native": "./src/rendezvous.ts",
      "default": "./dist/rendezvous.js"
    },
    "./local-authority": {
      "types": "./src/local-authority.ts",
      "react-native": "./src/local-authority.ts",
      "default": "./dist/local-authority.js"
    },
    "./cloud-library": {
      "types": "./src/cloud-library.ts",
      "react-native": "./src/cloud-library.ts",
      "default": "./dist/cloud-library.js"
    },
    "./cloud-backup": {
      "types": "./src/cloud-backup.ts",
      "react-native": "./src/cloud-backup.ts",
      "default": "./dist/cloud-backup.js"
    },
    "./cloud-library-bootstrap": {
      "types": "./src/cloud-library-bootstrap.ts",
      "react-native": "./src/cloud-library-bootstrap.ts",
      "default": "./dist/cloud-library-bootstrap.js"
    },
    "./cloud-library-assets": {
      "types": "./src/cloud-library-assets.ts",
      "react-native": "./src/cloud-library-assets.ts",
      "default": "./dist/cloud-library-assets.js"
    },
    "./cloud-library-projection": {
      "types": "./src/cloud-library-projection.ts",
      "react-native": "./src/cloud-library-projection.ts",
      "default": "./dist/cloud-library-projection.js"
    },
    "./cloud-library-atomic": {
      "types": "./src/cloud-library-atomic.ts",
      "react-native": "./src/cloud-library-atomic.ts",
      "default": "./dist/cloud-library-atomic.js"
    },
    "./webstack-release": {
      "types": "./src/webstack-release.ts",
      "react-native": "./src/webstack-release.ts",
      "default": "./dist/webstack-release.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flashcards/domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
