{
  "name": "@flashcards/direct-connect-webstack",
  "version": "0.5.137",
  "private": true,
  "type": "module",
  "exports": {
    "./local-app": "./src/local-app.ts",
    "./audio-optimization-storage": "./src/audio-optimization-storage.ts",
    "./local-authority-storage": "./src/local-authority-storage.ts",
    "./media-storage": "./src/media-storage.ts",
    "./peer-sync": "./src/peer-sync.ts",
    "./connection-state": "./src/connection-state.ts",
    "./apple-cloud-backup": "./src/apple-cloud-backup.ts",
    "./webstack-install": "./src/webstack-install.ts",
    "./identity": "./src/identity.ts",
    "./reconnect-runtime": "./src/reconnect-runtime.ts"
  },
  "scripts": {
    "build": "pnpm --filter @flashcards/domain build && pnpm --filter @flashcards/sync build && tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/core": "8.0.0",
    "@flashcards/domain": "workspace:*",
    "@flashcards/scheduler": "workspace:*",
    "@flashcards/sync": "workspace:*",
    "jsqr": "1.4.0",
    "toqr": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
