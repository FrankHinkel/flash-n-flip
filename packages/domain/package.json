{
  "name": "@flashcards/domain",
  "version": "0.5.88",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "types": "./src/content.ts",
      "react-native": "./src/content.ts",
      "default": "./dist/content.js"
    },
    "./markdown": {
      "types": "./src/markdown.ts",
      "react-native": "./src/markdown.ts",
      "default": "./dist/markdown.js"
    },
    "./deck-metrics": {
      "types": "./src/deck-metrics.ts",
      "react-native": "./src/deck-metrics.ts",
      "default": "./dist/deck-metrics.js"
    },
    "./deck-study-mode": {
      "types": "./src/deck-study-mode.ts",
      "react-native": "./src/deck-study-mode.ts",
      "default": "./dist/deck-study-mode.js"
    },
    "./europe-countries": {
      "types": "./src/europe-countries.generated.ts",
      "react-native": "./src/europe-countries.generated.ts",
      "default": "./dist/europe-countries.generated.js"
    },
    "./europe-map": {
      "types": "./src/europe-map.generated.ts",
      "react-native": "./src/europe-map.generated.ts",
      "default": "./dist/europe-map.generated.js"
    },
    "./geography": {
      "types": "./src/geography.ts",
      "react-native": "./src/geography.ts",
      "default": "./dist/geography.js"
    },
    "./geography-generated": {
      "types": "./src/geography.generated.ts",
      "react-native": "./src/geography.generated.ts",
      "default": "./dist/geography.generated.js"
    },
    "./geography-subdivisions-generated": {
      "types": "./src/geography-subdivisions.generated.ts",
      "react-native": "./src/geography-subdivisions.generated.ts",
      "default": "./dist/geography-subdivisions.generated.js"
    },
    "./geography-overlays": {
      "types": "./src/geography-overlays.ts",
      "react-native": "./src/geography-overlays.ts",
      "default": "./dist/geography-overlays.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
