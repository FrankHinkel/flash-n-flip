 			xhr.responseType = "arraybuffer";
 			xhr.onload = function () {
-				if (xhr.status !== 200) {
+				if (xhr.status !== 200 && !isSuccessfulLocalAppResponse(xhr.status, noteUrl)) {
 					reject(Error("Can't load sound at " + noteUrl + ' status=' + xhr.status));
 					return
 				}
