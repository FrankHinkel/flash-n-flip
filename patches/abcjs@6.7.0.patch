+++ b/src/synth/load-note.js
@@ -4,6 +4,18 @@
 // name = the pitch name (e.g. "A3")
 var soundsCache = require("./sounds-cache");
 
+var isSuccessfulLocalAppResponse = function (status, noteUrl) {
+	if (status !== 0 || typeof window === "undefined") return false;
+	try {
+		var requested = new URL(noteUrl, window.location.href);
+		var current = new URL(window.location.href);
+		var isNativeScheme = requested.protocol === "capacitor:" || requested.protocol === "flashnflip:";
+		return isNativeScheme && requested.protocol === current.protocol && requested.host === current.host;
+	} catch (_) {
+		return false;
+	}
+};
+
 var getNote = function (url, instrument, name, audioContext) {
 	if (!soundsCache[instrument]) soundsCache[instrument] = {};
 	var instrumentCache = soundsCache[instrument];
