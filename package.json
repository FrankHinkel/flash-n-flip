{
  "name": "flashcards",
  "version": "0.5.35",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:brand:check": "node scripts/generate-brand-assets.mjs --check",
    "assets:brand:test": "node --test scripts/generate-brand-assets.test.mjs",
    "assets:lucide": "node scripts/import-lucide-svg.mjs",
    "assets:lucide:check": "node scripts/import-lucide-svg.mjs --check",
    "assets:lucide:test": "node --test scripts/import-lucide-svg.test.mjs",
    "data:europe": "node scripts/generate-europe-countries.mjs && node scripts/generate-europe-map.mjs",
    "data:geography": "node scripts/generate-geography.mjs && node scripts/generate-geography-subdivisions.mjs",
    "build": "pnpm assets:brand && turbo run build",
    "dev": "pnpm assets:brand && turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "mobile:ios": "pnpm --filter @flashcards/mobile ios:go",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "version:check": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-patch-version.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "pnpm assets:brand:check && pnpm assets:brand:test && pnpm assets:lucide:check && pnpm assets:lucide:test && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": ".agents/skills/flashcards-release-readiness-review/scripts/check-release-readiness.sh"
  },
  "devDependencies": {
    "lucide-static": "1.27.0",
    "prettier": "3.9.6",
    "sharp": "0.34.5",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yauzl": "3.4.0"
  }
}
